{
	"name": "vssm-md",
	"displayName": "vssm-md",
	"description": "苏木的vscode扩展Markdown所见即所得编辑器",
	"version": "0.0.0",
	"publisher": "ms-vs-extensions",
	"icon": "image/logo.png",
	"engines": {
		"vscode": "^1.64.0"
	},
	"keywords": [
		"markdown",
		"editor",
		"wysiwyg",
		"vditor",
		"mermaid",
		"katex"
	],
	"categories": [
		"Other"
	],
	"bugs": {
		"url": "https://github.com/cweijan/vscode-office/issues",
		"email": "cweijan@163.com"
	},
	"homepage": "https://github.com/cweijan/vscode-office/blob/master/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/cweijan/vscode-office.git"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"browser": "./out/extension.web.js",
	"contributes": {
		"commands": [
			{
				"command": "office.markdown.switch",
				"title": "Switch markdown editor",
				"icon": "$(edit)"
			},
			{
				"command": "office.markdown.paste",
				"title": "Enhance paste in markdown",
				"enablement": "!office.extensionHost.web"
			}
		],
		"keybindings": [
			{
				"command": "office.markdown.paste",
				"key": "ctrl+v",
				"mac": "cmd+v",
				"when": "editorTextFocus && resourceLangId == markdown && !office.extensionHost.web"
			},
			{
				"command": "office.markdown.switch",
				"key": "ctrl+alt+e",
				"mac": "ctrl+cmd+e",
				"when": "editorTextFocus && editorLangId == markdown"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "office.markdown.switch",
					"when": "resourceExtname == '.md'",
					"group": "navigation@-2"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "cweijan.markdownViewer",
				"displayName": "Markdown Editor",
				"selector": [
					{
						"filenamePattern": "file:/**/*.md"
					},
					{
						"filenamePattern": "file:/**/*.markdown"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.md"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.markdown"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.md"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.markdown"
					}
				]
			}
		],
		"configuration": [
			{
				"title": "Markdown",
				"order": 1,
				"properties": {
					"vscode-office.preventMacOptionKey": {
						"type": "boolean",
						"default": true,
						"description": "Prevent MacOS option key in the markdown editor."
					},
					"vscode-office.editorTheme": {
						"type": "string",
						"enum": [
							"Auto",
							"Light",
							"Solarized",
							"Warm Light",
							"Dim Light",
							"One Dark",
							"Github Dark",
							"Nord",
							"Monokai",
							"Dracula"
						],
						"default": "Auto",
						"markdownDescription": "The theme for the Markdown editor."
					},
					"vscode-office.codeMirrorTheme": {
						"type": "string",
						"enum": [
							"Auto",
							"Github",
							"Solarized Light",
							"Material Light",
							"Quiet Light",
							"One Light",
							"Dracula",
							"Monokai",
							"One Dark",
							"Solarized Dark",
							"Material Dark"
						],
						"default": "Auto",
						"markdownDescription": "CodeMirror syntax theme for code blocks in the Markdown editor."
					},
					"vscode-office.mermaidTheme": {
						"type": "string",
						"enum": [
							"Auto",
							"Light",
							"Forest",
							"Ocean",
							"Sunset",
							"Dark",
							"Dracula",
							"Monokai",
							"Nord"
						],
						"default": "Auto",
						"markdownDescription": "Mermaid diagram theme in the Markdown editor. Auto follows the editor theme."
					},
					"vscode-office.editMode": {
						"type": "string",
						"enum": [
							"wysiwyg",
							"ir"
						],
						"default": "wysiwyg",
						"markdownDescription": "Default edit mode for the Markdown editor."
					},
					"vscode-office.restoreViewState": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "Restore caret focus when opening a Markdown file. Scroll position is always restored."
					},
					"vscode-office.workspacePathAsImageBasePath": {
						"type": "boolean",
						"default": false,
						"description": "Using workspace path as markdown image base path."
					},
					"vscode-office.pasteImageToWorkspacePath": {
						"type": "boolean",
						"default": false,
						"description": "Paste markdown images into the workspace path and insert image links with a leading slash."
					},
					"vscode-office.pasterImgPath": {
						"type": "string",
						"default": "image/${fileName}/${now}.${ext}",
						"description": "Markdown paste image path, variables: workspaceDir, fileName, now, date (YYYYMMDD), uuid, ext (file extension)."
					}
				}
			},
			{
				"title": "Markdown PDF",
				"order": 2,
				"properties": {
					"vscode-office.chromiumPath": {
						"type": "string",
						"description": "Set the chromium browser location for exporting markdown pdf."
					},
					"vscode-office.puppeteerArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional arguments to pass to Puppeteer/Chromium when exporting PDF. Example: [\"--no-sandbox\", \"--disable-setuid-sandbox\"] for Linux servers running as root."
					},
					"vscode-office.pdfMarginTop": {
						"type": "integer",
						"default": 25,
						"description": "Printed pdf default top margin."
					}
				}
			},
			{
				"title": "Telemetry",
				"order": 99,
				"properties": {
					"vscode-office.enableTelemetry": {
						"type": "boolean",
						"default": true,
						"tags": [
							"telemetry",
							"usesOnlineServices"
						],
						"markdownDescription": "Enable anonymous usage data collection to help improve Office Viewer. This respects VS Code global telemetry settings (`#telemetry.telemetryLevel#`)."
					}
				}
			}
		]
	},
	"scripts": {
		"dev": "vite --mode=development",
		"dev:web": "OFFICE_EXTENSION_TARGET=web vite --mode=development",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
		"build": "vite build --mode=production",
		"package": "vsce package --no-dependencies",
		"publish": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
		"vscode:prepublish": "npm run build"
	},
	"devDependencies": {
		"@types/diff-match-patch": "1.0.32",
		"@types/node": "^26.1.0",
		"@types/vscode": "^1.64.0",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.1",
		"esbuild-plugin-copy": "2.1.1",
		"eslint": "^9.39.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.7.0",
		"less": "^4.2.0",
		"vite": "^8.0.16",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@lezer/highlight": "^1.2.3",
		"@vscode/codicons": "^0.0.45",
		"@vscode/extension-telemetry": "^1.5.2",
		"axios": "^1.18.1",
		"chrome-finder": "^1.0.7",
		"codemirror-lang-latex": "^0.4.1",
		"codemirror-lang-mermaid": "^0.5.0",
		"diff-match-patch": "1.0.5",
		"file-type": "^19.6.0",
		"highlight.js": "^11.10.0",
		"katex": "^0.16.2",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-checkbox": "^1.1.0",
		"markdown-it-front-matter": "^0.2.4",
		"markdown-it-mark": "^4.0.0",
		"markdown-it-obsidian-callouts": "^0.3.4",
		"markdown-it-plantuml": "^1.4.1",
		"markdown-it-toc-done-right": "^4.2.0",
		"mermaid": "^11.15.0",
		"mustache": "^4.0.1",
		"node-html-parser": "^7.0.1",
		"pdf-lib": "^1.11.2",
		"puppeteer-core": "^25.1.0",
		"save-svg-as-png": "^1.4.17",
		"vscode-html-to-docx": "^1.1.3"
	}
}
